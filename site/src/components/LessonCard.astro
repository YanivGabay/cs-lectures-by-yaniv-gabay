---
interface Props {
  number: string;
  title: string;
  description: string;
  tags: string[];
  difficulty: 'beginner' | 'intermediate' | 'advanced';
  exampleCount: number;
  href: string;
  phase: string;
}

const { number, title, description, tags, difficulty, exampleCount, href } = Astro.props;

const diffColors = {
  beginner: 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400',
  intermediate: 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400',
  advanced: 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400',
};
---

<a href={href} class="card block p-5 group hover:-translate-y-0.5 transition-all duration-200 overflow-hidden">
  <div class="flex items-start gap-4">
    <div class="flex-shrink-0 w-11 h-11 rounded-xl bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center group-hover:bg-primary-200 dark:group-hover:bg-primary-900/50 transition-colors">
      <span class="text-base font-bold text-primary-700 dark:text-primary-400 font-mono">{number}</span>
    </div>
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2 mb-1">
        <h3 class="font-semibold text-surface-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors truncate">
          {title}
        </h3>
        <span class={`flex-shrink-0 text-[10px] px-1.5 py-0.5 rounded-full font-medium ${diffColors[difficulty]}`}>
          {difficulty}
        </span>
      </div>
      <p class="text-sm text-surface-600 dark:text-surface-400 line-clamp-2 mb-3">
        {description}
      </p>
      <div class="flex items-center justify-between">
        <div class="flex flex-wrap gap-1.5">
          {tags.slice(0, 3).map(tag => (
            <span class="tag text-[10px]">{tag}</span>
          ))}
          {tags.length > 3 && (
            <span class="text-[10px] text-surface-400">+{tags.length - 3}</span>
          )}
        </div>
        <span class="text-xs text-surface-500 flex-shrink-0 ml-2 flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" />
          </svg>
          {exampleCount}
        </span>
      </div>
    </div>
  </div>
  {/* Arrow indicator */}
  <div class="absolute right-4 top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 transition-all group-hover:translate-x-0 -translate-x-1">
    <svg class="w-5 h-5 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
    </svg>
  </div>
</a>
