---
import { Code } from 'astro:components';

interface Props {
  code: string;
  filename: string;
  lang?: string;
  compileCmd?: string;
  output?: string;
  collapsed?: boolean;
  needsInput?: boolean;
}

const { code, filename, lang = 'c', compileCmd, output, collapsed = false, needsInput = false } = Astro.props;
const lineCount = code.split('\n').length;
const shouldCollapse = collapsed || lineCount > 80;
const id = filename.replace(/[^a-zA-Z0-9]/g, '-');
---

<div class="code-block-wrapper group" id={`code-${id}`}>
  {/* Header bar */}
  <div class="flex items-center justify-between gap-2 px-3 sm:px-4 py-2.5 bg-surface-100 dark:bg-surface-800 border-b border-surface-200 dark:border-surface-700 rounded-t-xl">
    <div class="flex items-center gap-3 min-w-0">
      <div class="hidden sm:flex gap-1.5">
        <div class="w-3 h-3 rounded-full bg-red-400/80"></div>
        <div class="w-3 h-3 rounded-full bg-yellow-400/80"></div>
        <div class="w-3 h-3 rounded-full bg-green-400/80"></div>
      </div>
      <span class="text-sm font-medium text-surface-700 dark:text-surface-300 font-mono truncate">{filename}</span>
      <span class="hidden sm:inline text-xs text-surface-500 dark:text-surface-400 whitespace-nowrap">{lineCount} lines</span>
    </div>
    <div class="flex items-center gap-1.5 sm:gap-2 flex-shrink-0">
      <button
        class="fs-btn inline-flex items-center gap-1 text-xs px-2.5 py-1 rounded-md border border-surface-300 dark:border-surface-600 text-surface-700 dark:text-surface-400 hover:bg-surface-200 dark:hover:bg-surface-700 transition-colors"
        aria-label="Toggle fullscreen"
        title="Fullscreen (Esc to exit)"
      >
        <svg class="fs-enter w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" />
        </svg>
        <svg class="fs-exit hidden w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 9V4.5M9 9H4.5M9 9 3.75 3.75M9 15v4.5M9 15H4.5M9 15l-5.25 5.25M15 9h4.5M15 9V4.5M15 9l5.25-5.25M15 15h4.5M15 15v4.5m0-4.5 5.25 5.25" />
        </svg>
        <span class="fs-label hidden sm:inline">Fullscreen</span>
      </button>
      <button
        class="edit-btn text-xs px-2.5 py-1 rounded-md border border-surface-300 dark:border-surface-600 text-surface-700 dark:text-surface-400 hover:bg-surface-200 dark:hover:bg-surface-700 transition-colors"
        data-target={`code-${id}`}
      >
        <span class="edit-text">Edit</span>
        <span class="viewing-text hidden text-accent-500">Viewing</span>
      </button>
      <button
        class="copy-btn text-xs px-2.5 py-1 rounded-md border border-surface-300 dark:border-surface-600 text-surface-700 dark:text-surface-400 hover:bg-surface-200 dark:hover:bg-surface-700 transition-colors"
        data-code={code}
        aria-label="Copy code"
      >
        <span class="copy-text">Copy</span>
        <span class="copied-text hidden text-primary-600 dark:text-primary-400">Copied!</span>
      </button>
    </div>
  </div>

  {/* Code content */}
  <div
    id={`code-content-${id}`}
    class:list={[
      'code-scroll relative overflow-x-auto',
      shouldCollapse && 'max-h-[400px] overflow-y-hidden collapsed',
    ]}
  >
    <Code code={code} lang={lang} theme="github-dark" />
    {shouldCollapse && <div class="code-fade pointer-events-none absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-[#24292e] to-transparent"></div>}
  </div>
  {shouldCollapse && (
    <button
      class="expand-btn w-full flex items-center justify-center gap-1.5 py-2 text-xs font-medium bg-[#24292e] text-surface-300 hover:text-white hover:bg-[#2d333b] border-t border-surface-700 transition-colors"
      data-target={`code-content-${id}`}
      aria-expanded="false"
    >
      <span class="expand-text">Show all {lineCount} lines ↓</span>
      <span class="collapse-text hidden">Show less ↑</span>
    </button>
  )}

  {/* Editor (hidden by default) — CodeMirror loaded on demand */}
  <div class="code-editor hidden" id={`editor-${id}`} data-original={code}>
    <div class="cm-host" style={`min-height: 200px; max-height: 500px; overflow: auto; background: #0d1117;`}></div>
    <div class="flex items-center justify-between px-4 py-2 bg-[#161b22] border-t border-[#30363d]">
      <span class="text-xs text-[#484f58]">Editing — changes sent to terminal on Run</span>
      <button class="reset-btn text-xs px-2 py-1 rounded text-yellow-400 hover:bg-[#30363d] transition-colors">
        Reset to Original
      </button>
    </div>
  </div>

  {/* Output panel */}
  {output && (
    <div class="terminal-output">
      <div class="text-xs text-surface-500 mb-2 uppercase tracking-wider flex items-center gap-2">
        <span>Expected Output</span>
        <span class="text-[10px] normal-case opacity-60">click Run to execute live</span>
      </div>
      <pre class="whitespace-pre-wrap text-emerald-300">{output}</pre>
    </div>
  )}

  {/* Action bar */}
  <div class="flex items-center justify-between px-4 py-2.5 bg-surface-100 dark:bg-surface-850 border-t border-surface-200 dark:border-surface-700 rounded-b-xl">
    <div class="flex items-center gap-3 min-w-0">
      {needsInput && (
        <span class="hidden sm:inline-flex items-center gap-1 text-[10px] text-yellow-600 dark:text-yellow-400 whitespace-nowrap">
          <svg class="w-3 h-3 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
          </svg>
          Interactive
        </span>
      )}
    </div>
    <button
      class="open-terminal-btn inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-semibold bg-primary-600 text-white hover:bg-primary-700 active:bg-primary-800 transition-colors shadow-sm hover:shadow disabled:opacity-60 disabled:cursor-wait"
      data-filename={filename}
      data-code={code}
      data-compile={compileCmd || `gcc -o prog ${filename}`}
      data-interactive={needsInput ? 'true' : 'false'}
    >
      <svg class="run-play w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z" />
      </svg>
      <svg class="run-spinner hidden w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <span class="run-label">{needsInput ? 'Run (Interactive)' : 'Run'}</span>
    </button>
  </div>

  {/* Terminal will be injected here */}
  <div class="terminal-slot" data-filename={filename} data-code={code}></div>
</div>

<script>
  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const code = (btn as HTMLElement).dataset.code || '';
      await navigator.clipboard.writeText(code);
      const copyText = btn.querySelector('.copy-text') as HTMLElement;
      const copiedText = btn.querySelector('.copied-text') as HTMLElement;
      copyText.classList.add('hidden');
      copiedText.classList.remove('hidden');
      setTimeout(() => {
        copyText.classList.remove('hidden');
        copiedText.classList.add('hidden');
      }, 2000);
    });
  });

  document.querySelectorAll('.expand-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = (btn as HTMLElement).dataset.target!;
      const target = document.getElementById(targetId)!;
      const isCollapsed = target.classList.contains('collapsed');
      target.classList.toggle('collapsed', !isCollapsed);
      target.classList.toggle('max-h-[400px]', !isCollapsed);
      target.classList.toggle('overflow-y-hidden', !isCollapsed);
      btn.setAttribute('aria-expanded', String(isCollapsed));
      const expandText = btn.querySelector('.expand-text') as HTMLElement;
      const collapseText = btn.querySelector('.collapse-text') as HTMLElement;
      expandText.classList.toggle('hidden', isCollapsed);
      collapseText.classList.toggle('hidden', !isCollapsed);
      // After collapsing a long file, bring its header back into view
      if (!isCollapsed) {
        const wrapper = btn.closest('.code-block-wrapper') as HTMLElement;
        if (wrapper.getBoundingClientRect().top < 0) wrapper.scrollIntoView({ block: 'start' });
      }
    });
  });

  // Fullscreen mode: code on top, terminal below, filling the viewport
  function setFullscreen(wrapper: HTMLElement, on: boolean) {
    wrapper.classList.toggle('is-fullscreen', on);
    document.body.classList.toggle('fs-lock', on);
    wrapper.querySelectorAll('.fs-enter').forEach(e => e.classList.toggle('hidden', on));
    wrapper.querySelectorAll('.fs-exit').forEach(e => e.classList.toggle('hidden', !on));
    wrapper.querySelectorAll('.fs-label').forEach(e => { e.textContent = on ? 'Exit' : 'Fullscreen'; });
    const editorDiv = wrapper.querySelector('.code-editor') as HTMLElement | null;
    const cm = editorDiv ? editorInstances.get(editorDiv) : null;
    if (cm) {
      cm.setSize(null, on ? '100%' : Math.min(cm.lineCount() * 22 + 16, 500));
      cm.refresh();
    }
  }

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.fs-btn, .terminal-fs');
    if (!btn) return;
    // Prefer the whole code block (code + terminal); fall back to a standalone terminal
    const wrapper = (btn.closest('.code-block-wrapper') || btn.closest('.terminal-container')) as HTMLElement | null;
    if (wrapper) setFullscreen(wrapper, !wrapper.classList.contains('is-fullscreen'));
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    // Esc inside the terminal belongs to the running program, not to us
    if ((e.target as HTMLElement).closest?.('.xterm')) return;
    const open = document.querySelector('.is-fullscreen') as HTMLElement | null;
    if (open) setFullscreen(open, false);
  });

  // CodeMirror lazy loader
  let cmLoaded: Promise<any> | null = null;
  const editorInstances = new Map<HTMLElement, any>();

  function loadCodeMirror(): Promise<any> {
    if (cmLoaded) return cmLoaded;
    cmLoaded = new Promise((resolve) => {
      const css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = 'https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.18/codemirror.min.css';
      document.head.appendChild(css);

      const themeCss = document.createElement('link');
      themeCss.rel = 'stylesheet';
      themeCss.href = 'https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.18/theme/material-darker.min.css';
      document.head.appendChild(themeCss);

      const script = document.createElement('script');
      script.src = 'https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.18/codemirror.min.js';
      script.onload = () => {
        const mode = document.createElement('script');
        mode.src = 'https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.18/mode/clike/clike.min.js';
        mode.onload = () => resolve((window as any).CodeMirror);
        document.head.appendChild(mode);
      };
      document.head.appendChild(script);
    });
    return cmLoaded;
  }

  async function initEditor(editorDiv: HTMLElement): Promise<any> {
    if (editorInstances.has(editorDiv)) return editorInstances.get(editorDiv);

    const CodeMirror = await loadCodeMirror();
    const host = editorDiv.querySelector('.cm-host') as HTMLElement;
    const code = editorDiv.dataset.original || '';

    const cm = CodeMirror(host, {
      value: code,
      mode: 'text/x-csrc',
      theme: 'material-darker',
      lineNumbers: true,
      tabSize: 4,
      indentWithTabs: false,
      lineWrapping: false,
      matchBrackets: true,
      autoCloseBrackets: true,
    });

    cm.setSize(null, Math.min(cm.lineCount() * 22 + 16, 500));
    editorInstances.set(editorDiv, cm);
    return cm;
  }

  function getEditorCode(wrapper: HTMLElement): string | null {
    const editorDiv = wrapper.querySelector('.code-editor') as HTMLElement | null;
    if (!editorDiv || editorDiv.classList.contains('hidden')) return null;
    const cm = editorInstances.get(editorDiv);
    return cm ? cm.getValue() : null;
  }

  // Edit toggle
  document.querySelectorAll('.edit-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const el = btn as HTMLElement;
      const wrapperId = el.dataset.target!;
      const wrapper = document.getElementById(wrapperId)!;
      const codeView = wrapper.querySelector('[id^="code-content-"]') as HTMLElement;
      const editorDiv = wrapper.querySelector('.code-editor') as HTMLElement;
      const editText = el.querySelector('.edit-text') as HTMLElement;
      const viewingText = el.querySelector('.viewing-text') as HTMLElement;

      const isEditing = !editorDiv.classList.contains('hidden');

      if (!isEditing) {
        // Switching to edit mode — load CodeMirror
        codeView.classList.add('hidden');
        editorDiv.classList.remove('hidden');
        editText.classList.add('hidden');
        viewingText.classList.remove('hidden');
        const cm = await initEditor(editorDiv);
        cm.refresh();
        cm.focus();
      } else {
        // Switching back to view mode
        codeView.classList.remove('hidden');
        editorDiv.classList.add('hidden');
        editText.classList.remove('hidden');
        viewingText.classList.add('hidden');
      }
    });
  });

  // Reset button
  document.querySelectorAll('.reset-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const editorDiv = btn.closest('.code-editor') as HTMLElement;
      const cm = editorInstances.get(editorDiv);
      if (cm) cm.setValue(editorDiv.dataset.original || '');
    });
  });

  // Terminal: import xterm directly here so it's guaranteed to be in the bundle
  import { Terminal } from '@xterm/xterm';
  import { FitAddon } from '@xterm/addon-fit';

  // Syscall tooltips
  import { syscallReference } from '../data/syscall-reference';

  function getTerminalUrl(): string {
    const meta = document.querySelector('meta[name="terminal-url"]') as HTMLMetaElement | null;
    const base = meta?.content || localStorage.getItem('terminal-url') || '';
    let key: string | null = null;
    try { key = localStorage.getItem('presenterKey'); } catch {}
    // Presenter's browser goes to the reserved sandbox; everyone else to the student pool
    return base && key ? `${base}${base.includes('?') ? '&' : '?'}presenter=${encodeURIComponent(key)}` : base;
  }

  function launchTerminal(container: HTMLElement, files: {name: string, content: string}[], autoRun: string, isInteractive: boolean, onReady?: () => void) {
    const target = container.querySelector('.terminal-target') as HTMLElement;
    const statusEl = container.querySelector('.terminal-status') as HTMLElement;
    const killBtn = container.querySelector('.terminal-kill') as HTMLElement;
    const closeBtn = container.querySelector('.terminal-close') as HTMLElement;

    const term = new Terminal({
      theme: {
        background: '#0f172a',
        foreground: '#e2e8f0',
        cursor: '#22d3ee',
        selectionBackground: '#334155',
      },
      fontFamily: "'JetBrains Mono', 'Fira Code', monospace",
      fontSize: 13,
      lineHeight: 1.4,
      cursorBlink: true,
    });

    const fitAddon = new FitAddon();
    term.loadAddon(fitAddon);
    term.open(target);

    setTimeout(() => {
      fitAddon.fit();

      const url = getTerminalUrl();
      if (!url) {
        term.writeln('\x1b[1;31mTerminal server not configured.\x1b[0m');
        term.writeln('Run: \x1b[33mlocalStorage.setItem("terminal-url","ws://localhost:8090")\x1b[0m then reload.');
        return;
      }

      statusEl.textContent = 'Connecting...';
      const ws = new WebSocket(url);

      ws.onopen = () => {
        statusEl.textContent = 'Starting...';
        // example mode: quiet shell that auto-compiles; lesson mode: welcome banner + file list
        ws.send(JSON.stringify({ type: 'start', files, cols: term.cols, rows: term.rows, mode: autoRun ? 'example' : 'lesson' }));
      };

      // States: 'waiting' -> 'compiling' -> 'compiled'
      let state = autoRun ? 'waiting' : 'done';
      let promptCount = 0;

      ws.onmessage = (event) => {
        const msg = JSON.parse(event.data);
        if (msg.type === 'ready') {
          statusEl.textContent = 'Connected';
          killBtn.classList.remove('hidden');
          if (onReady) onReady();
        } else if (msg.type === 'output') {
          term.write(msg.data);

          if (msg.data.includes('$ ') || msg.data.includes('# ')) {
            promptCount++;

            if (state === 'waiting' && promptCount === 1) {
              // First prompt: shell is ready, send compile command
              state = 'compiling';
              setTimeout(() => ws.send(JSON.stringify({ type: 'input', data: autoRun + '\n' })), 100);
            } else if (state === 'compiling' && promptCount >= 2) {
              // Second prompt: compile finished — run it
              state = 'compiled';
              const outputName = autoRun.match(/-o\s+(\S+)/)?.[1] || 'prog';
              setTimeout(() => ws.send(JSON.stringify({ type: 'input', data: `./${outputName}\n` })), 50);
            }
          }
        } else if (msg.type === 'exit') {
          if (msg.data) term.write(msg.data);
          statusEl.textContent = 'Disconnected';
          killBtn.classList.add('hidden');
        } else if (msg.type === 'error') {
          term.writeln(`\x1b[1;31m${msg.data}\x1b[0m`);
          statusEl.textContent = 'Error';
        }
      };

      ws.onclose = () => { statusEl.textContent = 'Disconnected'; killBtn.classList.add('hidden'); };
      ws.onerror = () => { term.writeln('\x1b[1;31mConnection failed.\x1b[0m'); statusEl.textContent = 'Error'; };

      term.onData((data) => { if (ws.readyState === 1) ws.send(JSON.stringify({ type: 'input', data })); });
      term.onResize(({ cols, rows }) => { if (ws.readyState === 1) ws.send(JSON.stringify({ type: 'resize', cols, rows })); });

      let fitTimeout: ReturnType<typeof setTimeout>;
      const ro = new ResizeObserver(() => {
        clearTimeout(fitTimeout);
        fitTimeout = setTimeout(() => {
          const scrollY = window.scrollY;
          fitAddon.fit();
          window.scrollTo(0, scrollY);
        }, 100);
      });
      ro.observe(target);

      killBtn.addEventListener('click', () => { if (ws.readyState === 1) ws.send(JSON.stringify({ type: 'signal', signal: 'SIGINT' })); });
      closeBtn.addEventListener('click', () => {
        if (container.classList.contains('is-fullscreen')) document.body.classList.remove('fs-lock');
        ws.close(); ro.disconnect(); term.dispose(); container.remove();
      });
    }, 150);
  }

  // Expose globally so "Open Full Terminal" on lesson pages can use it
  (window as any).__launchTerminal = launchTerminal;

  document.querySelectorAll('.open-terminal-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const el = btn as HTMLButtonElement;
      const filename = el.dataset.filename || 'main.c';
      const compileCmd = el.dataset.compile || `gcc -o prog ${filename}`;
      const isInteractive = el.dataset.interactive === 'true';
      const wrapper = el.closest('.code-block-wrapper')!;
      const slot = wrapper.querySelector('.terminal-slot') as HTMLElement;

      // Loading state
      const playIcon = el.querySelector('.run-play') as HTMLElement;
      const spinnerIcon = el.querySelector('.run-spinner') as HTMLElement;
      const label = el.querySelector('.run-label') as HTMLElement;
      const origLabel = label.textContent;
      el.disabled = true;
      playIcon?.classList.add('hidden');
      spinnerIcon?.classList.remove('hidden');
      label.textContent = 'Starting...';

      // Always get the latest code — from CodeMirror editor if open, otherwise original
      const editedCode = getEditorCode(wrapper);
      const code = editedCode !== null ? editedCode : (el.dataset.code || '');

      // Destroy existing terminal — always start fresh with current code
      const existing = slot.querySelector('.terminal-container');
      if (existing) existing.remove();

      const termDiv = document.createElement('div');
      termDiv.className = 'terminal-container';
      termDiv.innerHTML = `
        <div class="flex items-center justify-between px-4 py-2 bg-surface-900 border-t border-surface-700">
          <div class="flex items-center gap-2">
            <div class="flex gap-1.5">
              <div class="w-3 h-3 rounded-full bg-red-500"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
              <div class="w-3 h-3 rounded-full bg-green-500"></div>
            </div>
            <span class="text-sm font-mono text-surface-400">Terminal</span>
            <span class="terminal-status text-xs text-surface-500"></span>
          </div>
          <div class="flex items-center gap-2">
            <button class="terminal-kill text-xs px-2 py-1 rounded text-red-400 hover:bg-surface-800 transition-colors hidden">Ctrl+C</button>
            <button class="terminal-fs text-xs px-2 py-1 rounded text-surface-400 hover:bg-surface-800 transition-colors"><span class="fs-enter">Fullscreen</span><span class="fs-exit hidden">Exit fullscreen</span></button>
            <button class="terminal-close text-xs px-2 py-1 rounded text-surface-400 hover:bg-surface-800 transition-colors">Close</button>
          </div>
        </div>
        <div class="terminal-target bg-surface-950" style="height:350px;"></div>
      `;
      slot.appendChild(termDiv);

      // the compile command expects the file in the working directory, so drop any folder prefix
      const baseName = filename.split('/').pop() || filename;
      launchTerminal(termDiv, [{ name: baseName, content: code }], compileCmd, isInteractive, () => {
        // Restore Run button
        el.disabled = false;
        playIcon?.classList.remove('hidden');
        spinnerIcon?.classList.add('hidden');
        label.textContent = origLabel || 'Run';
      });
    });
  });

  // --- Syscall tooltip initialization ---
  (function initSyscallTooltips() {
    const names = Object.keys(syscallReference);
    if (!names.length) return;

    // Build regex that matches syscall names followed by ( in code
    const pattern = new RegExp(`\\b(${names.join('|')})(?=\\s*\\()`, 'g');

    // Create reusable tooltip element
    let tooltip: HTMLDivElement | null = null;
    let hideTimer: ReturnType<typeof setTimeout>;

    function getTooltip(): HTMLDivElement {
      if (tooltip) return tooltip;
      tooltip = document.createElement('div');
      tooltip.className = 'syscall-tooltip';
      tooltip.hidden = true;
      document.body.appendChild(tooltip);

      tooltip.addEventListener('mouseenter', () => clearTimeout(hideTimer));
      tooltip.addEventListener('mouseleave', () => {
        hideTimer = setTimeout(() => { tooltip!.hidden = true; }, 150);
      });

      return tooltip;
    }

    function showTooltip(el: HTMLElement) {
      const name = el.dataset.syscall;
      if (!name) return;
      const info = syscallReference[name];
      if (!info) return;

      clearTimeout(hideTimer);
      const tt = getTooltip();

      let html = `<code class="st-sig">${info.signature}</code>`;
      html += `<div>${info.description}</div>`;
      html += `<div class="st-returns"><strong>Returns:</strong> ${info.returns}</div>`;
      if (info.pitfall) {
        html += `<div class="st-pitfall">⚠ ${info.pitfall}</div>`;
      }
      html += `<a href="${info.man}" target="_blank" rel="noopener" class="st-man">man page →</a>`;
      tt.innerHTML = html;
      tt.hidden = false;

      const rect = el.getBoundingClientRect();
      tt.style.left = `${Math.min(rect.left, window.innerWidth - 360)}px`;
      tt.style.top = `${rect.bottom + 6}px`;
    }

    function hideTooltipDelayed() {
      hideTimer = setTimeout(() => {
        if (tooltip) tooltip.hidden = true;
      }, 200);
    }

    // Walk all code lines and wrap syscall names
    document.querySelectorAll('.code-block-wrapper code .line').forEach(line => {
      const walker = document.createTreeWalker(line, NodeFilter.SHOW_TEXT);
      const textNodes: Text[] = [];
      let node: Text | null;
      while ((node = walker.nextNode() as Text | null)) {
        textNodes.push(node);
      }

      for (const textNode of textNodes) {
        const text = textNode.textContent || '';
        pattern.lastIndex = 0;
        const match = pattern.exec(text);
        if (!match) continue;

        const before = text.substring(0, match.index);
        const matched = match[1];
        const after = text.substring(match.index + matched.length);

        const span = document.createElement('span');
        span.className = 'syscall-hint';
        span.dataset.syscall = matched;
        span.textContent = matched;
        span.addEventListener('mouseenter', () => showTooltip(span));
        span.addEventListener('mouseleave', hideTooltipDelayed);

        const parent = textNode.parentNode!;
        if (before) parent.insertBefore(document.createTextNode(before), textNode);
        parent.insertBefore(span, textNode);
        if (after) parent.insertBefore(document.createTextNode(after), textNode);
        parent.removeChild(textNode);
      }
    });
  })();
</script>
