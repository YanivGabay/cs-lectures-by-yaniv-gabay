---
interface Node {
  id: string;
  label: string;
  slug: string;
  phase: string;
}

interface Edge {
  from: string;
  to: string;
}

const nodes: Node[] = [
  { id: '01',   label: 'C Basics',        slug: '01-intro-to-c',              phase: 'foundation' },
  { id: '01.5', label: 'argc/argv',       slug: '01.5-more-intro-to-c',      phase: 'foundation' },
  { id: '02',   label: 'fork()',          slug: '02-basic-forks',             phase: 'processes' },
  { id: '03',   label: 'Signals',         slug: '03-signals-intro',           phase: 'processes' },
  { id: '04',   label: 'exec()',          slug: '04-exec',                    phase: 'processes' },
  { id: '05',   label: 'Spawn',           slug: '05-spawn-windows',           phase: 'processes' },
  { id: '06',   label: 'sigaction',       slug: '06-sigaction',               phase: 'signals' },
  { id: '07',   label: 'Coordination',    slug: '07-signal-coordination',     phase: 'signals' },
  { id: '08',   label: 'Pipes',           slug: '08-pipes',                   phase: 'ipc' },
  { id: '09',   label: 'Named Pipes',     slug: '09-named-pipes-msg-queues',  phase: 'ipc' },
  { id: '10',   label: 'Shared Mem',      slug: '10-shared-memory',           phase: 'ipc' },
  { id: '11',   label: 'Sockets',         slug: '11-sockets',                 phase: 'ipc' },
  { id: '12',   label: 'pthreads',        slug: '12-pthreads',               phase: 'threads' },
  { id: '13',   label: 'Sync',            slug: '13-synchronization',         phase: 'threads' },
  { id: '14',   label: 'Advanced',        slug: '14-cool-pthreads',           phase: 'threads' },
  { id: '15',   label: 'Exam Prep',       slug: '15-exam-prep',               phase: 'exam' },
];

const edges: Edge[] = [
  { from: '01', to: '01.5' },
  { from: '01.5', to: '02' },
  { from: '02', to: '03' },
  { from: '02', to: '04' },
  { from: '03', to: '06' },
  { from: '04', to: '05' },
  { from: '06', to: '07' },
  { from: '04', to: '08' },
  { from: '08', to: '09' },
  { from: '09', to: '10' },
  { from: '10', to: '11' },
  { from: '11', to: '12' },
  { from: '12', to: '13' },
  { from: '13', to: '14' },
  { from: '14', to: '15' },
];

const phaseColors: Record<string, { bg: string; border: string; text: string }> = {
  foundation: { bg: 'var(--cg-blue-bg)',   border: 'var(--cg-blue-border)',   text: 'var(--cg-blue-text)' },
  processes:  { bg: 'var(--cg-green-bg)',  border: 'var(--cg-green-border)',  text: 'var(--cg-green-text)' },
  signals:    { bg: 'var(--cg-yellow-bg)', border: 'var(--cg-yellow-border)', text: 'var(--cg-yellow-text)' },
  ipc:        { bg: 'var(--cg-orange-bg)', border: 'var(--cg-orange-border)', text: 'var(--cg-orange-text)' },
  threads:    { bg: 'var(--cg-red-bg)',    border: 'var(--cg-red-border)',    text: 'var(--cg-red-text)' },
  exam:       { bg: 'var(--cg-purple-bg)', border: 'var(--cg-purple-border)', text: 'var(--cg-purple-text)' },
};

// Layout: rows of nodes. Each row is a horizontal group.
const rows = [
  ['01', '01.5'],
  ['02', '03', '04'],
  ['06', '07', '05'],
  ['08', '09'],
  ['10', '11'],
  ['12', '13', '14'],
  ['15'],
];

const nodeW = 120;
const nodeH = 52;
const gapX = 24;
const gapY = 32;
const padX = 20;
const padY = 20;

// Compute max row width to center the SVG
const maxCols = Math.max(...rows.map(r => r.length));
const svgW = padX * 2 + maxCols * nodeW + (maxCols - 1) * gapX;
const svgH = padY * 2 + rows.length * nodeH + (rows.length - 1) * gapY;

// Position each node
const positions: Record<string, { x: number; y: number }> = {};
rows.forEach((row, ri) => {
  const rowW = row.length * nodeW + (row.length - 1) * gapX;
  const offsetX = (svgW - rowW) / 2;
  row.forEach((id, ci) => {
    positions[id] = {
      x: offsetX + ci * (nodeW + gapX),
      y: padY + ri * (nodeH + gapY),
    };
  });
});
---

<div class="concept-graph-wrap">
  <h3 class="text-lg font-bold text-surface-900 dark:text-white mb-4">Concept Map</h3>
  <div class="overflow-x-auto">
    <svg
      viewBox={`0 0 ${svgW} ${svgH}`}
      width={svgW}
      class="concept-graph mx-auto"
      role="img"
      aria-label="Lesson dependency graph showing how OS course topics connect"
    >
      <defs>
        <marker id="arrow" viewBox="0 0 10 7" refX="10" refY="3.5" markerWidth="8" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 0 L 10 3.5 L 0 7 z" class="cg-arrow" />
        </marker>
      </defs>

      {/* Edges */}
      {edges.map(({ from, to }) => {
        const a = positions[from];
        const b = positions[to];
        if (!a || !b) return null;

        const ax = a.x + nodeW / 2;
        const ay = a.y + nodeH;
        const bx = b.x + nodeW / 2;
        const by = b.y;

        // If same row (horizontal), draw from right edge to left edge
        const sameRow = a.y === b.y;
        if (sameRow) {
          const sx = a.x + nodeW;
          const sy = a.y + nodeH / 2;
          const ex = b.x;
          const ey = b.y + nodeH / 2;
          return (
            <line x1={sx} y1={sy} x2={ex - 2} y2={ey} class="cg-edge" marker-end="url(#arrow)" />
          );
        }

        // Vertical or diagonal: draw with a curved path
        const midY = (ay + by) / 2;
        return (
          <path
            d={`M ${ax} ${ay} C ${ax} ${midY}, ${bx} ${midY}, ${bx} ${by - 2}`}
            class="cg-edge"
            marker-end="url(#arrow)"
          />
        );
      })}

      {/* Nodes */}
      {nodes.map(node => {
        const pos = positions[node.id];
        if (!pos) return null;
        const colors = phaseColors[node.phase];
        return (
          <a href={`/os/${node.slug}/`} class="cg-node-link">
            <rect
              x={pos.x}
              y={pos.y}
              width={nodeW}
              height={nodeH}
              rx="10"
              ry="10"
              fill={colors.bg}
              stroke={colors.border}
              stroke-width="1.5"
              class="cg-node-rect"
            />
            <text
              x={pos.x + nodeW / 2}
              y={pos.y + 20}
              text-anchor="middle"
              class="cg-node-number"
              fill={colors.text}
            >
              {node.id}
            </text>
            <text
              x={pos.x + nodeW / 2}
              y={pos.y + 38}
              text-anchor="middle"
              class="cg-node-label"
              fill={colors.text}
            >
              {node.label}
            </text>
          </a>
        );
      })}
    </svg>
  </div>
</div>

<style>
  .concept-graph-wrap {
    max-width: 100%;
  }
  .concept-graph {
    display: block;
    max-width: 100%;
    height: auto;
  }
  .cg-edge {
    stroke: var(--cg-edge-color);
    stroke-width: 1.5;
    fill: none;
  }
  .cg-arrow {
    fill: var(--cg-edge-color);
  }
  .cg-node-number {
    font-size: 13px;
    font-weight: 700;
    font-family: var(--font-mono, monospace);
  }
  .cg-node-label {
    font-size: 11px;
    font-weight: 500;
    font-family: system-ui, sans-serif;
  }
  .cg-node-rect {
    transition: filter 0.15s;
  }
  .cg-node-link:hover .cg-node-rect {
    filter: brightness(1.1);
    stroke-width: 2.5;
  }

  /* Light mode colors */
  :root {
    --cg-edge-color: #94a3b8;
    --cg-blue-bg: #dbeafe;
    --cg-blue-border: #60a5fa;
    --cg-blue-text: #1e40af;
    --cg-green-bg: #dcfce7;
    --cg-green-border: #4ade80;
    --cg-green-text: #166534;
    --cg-yellow-bg: #fef9c3;
    --cg-yellow-border: #facc15;
    --cg-yellow-text: #854d0e;
    --cg-orange-bg: #ffedd5;
    --cg-orange-border: #fb923c;
    --cg-orange-text: #9a3412;
    --cg-red-bg: #fee2e2;
    --cg-red-border: #f87171;
    --cg-red-text: #991b1b;
    --cg-purple-bg: #f3e8ff;
    --cg-purple-border: #c084fc;
    --cg-purple-text: #6b21a8;
  }

  /* Dark mode colors */
  :global(html.dark) {
    --cg-edge-color: #475569;
    --cg-blue-bg: #1e3a5f;
    --cg-blue-border: #3b82f6;
    --cg-blue-text: #93c5fd;
    --cg-green-bg: #14532d;
    --cg-green-border: #22c55e;
    --cg-green-text: #86efac;
    --cg-yellow-bg: #422006;
    --cg-yellow-border: #eab308;
    --cg-yellow-text: #fde68a;
    --cg-orange-bg: #431407;
    --cg-orange-border: #f97316;
    --cg-orange-text: #fdba74;
    --cg-red-bg: #450a0a;
    --cg-red-border: #ef4444;
    --cg-red-text: #fca5a5;
    --cg-purple-bg: #3b0764;
    --cg-purple-border: #a855f7;
    --cg-purple-text: #d8b4fe;
  }
</style>
