---
import { lessons } from '../data/os-lessons';
const lessonHref = (n: string) => `/os/${lessons.find((l) => l.number === n)?.slug ?? ''}/`;
// Lesson 16: the path of one Run click, and the path of Ctrl+C — each step names the
// system call and the lesson that teaches it.
const runPath = [
  { who: 'Your browser', what: 'opens a WebSocket and sends your files', call: 'WebSocket', lesson: '11' },
  { who: 'Cloudflare Worker', what: 'checks the website, rate-limits, picks a sandbox with room', call: 'HTTP upgrade', lesson: '11' },
  { who: 'Container (tiny Linux VM)', what: 'tini is PID 1 — it reaps orphaned processes so no zombies pile up', call: 'wait()', lesson: '02' },
  { who: 'Supervisor (Node.js, root)', what: 'creates a throw-away Unix user and a 0700 folder, writes your files', call: 'adduser, chown', lesson: '01' },
  { who: 'forkpty()', what: 'a new process attached to a pseudo-terminal', call: 'fork()', lesson: '02' },
  { who: 'sandbox-launch', what: 'private IPC, network and /tmp for this session', call: 'unshare()', lesson: '09' },
  { who: 'sandbox-launch', what: '64 processes, 120 s CPU, 512 MB, 128 open files', call: 'setrlimit()', lesson: '02' },
  { who: 'sandbox-launch', what: 'gives up root — for good', call: 'setgid() / setuid()', lesson: '04' },
  { who: 'bash', what: 'the launcher becomes your shell; everything above is inherited', call: 'execve()', lesson: '04' },
  { who: 'Your program', what: 'gcc, then ./prog — a child of bash with all the limits', call: 'fork() + exec()', lesson: '04' },
];
const ctrlC = [
  { who: 'Ctrl+C button', what: 'types the ^C character into the terminal — it kills nothing itself' },
  { who: 'Terminal driver (kernel)', what: 'sees ^C and sends SIGINT to the foreground process group' },
  { who: 'Your program + its children', what: 'all get SIGINT: default action ends them, a handler can catch it' },
  { who: 'bash', what: 'ignores SIGINT, prints a new prompt; the site reads the exit status (130 = 128 + 2)' },
];
---

<div class="card p-6 mb-8" id="sandbox-visualizer">
  <h3 class="text-lg font-semibold text-surface-900 dark:text-white mb-1">What happens when you click Run</h3>
  <p class="text-sm text-surface-600 dark:text-surface-400 mb-5">Every step uses a system call from this course. Click a lesson tag to revisit it.</p>

  <div class="grid gap-8 lg:grid-cols-[3fr_2fr]">
    <ol class="space-y-2">
      {runPath.map((s, i) => (
        <li class="sv-step relative flex gap-3 items-start">
          <span class="flex-shrink-0 w-7 h-7 rounded-full bg-primary-600 text-white text-xs font-bold flex items-center justify-center">{i + 1}</span>
          <div class="flex-1 min-w-0 rounded-lg border border-surface-200 dark:border-surface-700 px-3 py-2 bg-surface-50 dark:bg-surface-900">
            <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
              <span class="font-semibold text-sm text-surface-900 dark:text-white">{s.who}</span>
              <code class="text-xs font-mono px-1.5 py-0.5 rounded bg-surface-200 dark:bg-surface-800 text-surface-800 dark:text-surface-200">{s.call}</code>
              <a href={lessonHref(s.lesson)} class="sv-lesson ml-auto text-[11px] px-1.5 py-0.5 rounded-full bg-primary-100 text-primary-800 dark:bg-primary-900/40 dark:text-primary-200 hover:underline">L{s.lesson}</a>
            </div>
            <p class="text-xs text-surface-700 dark:text-surface-300 mt-0.5">{s.what}</p>
          </div>
        </li>
      ))}
    </ol>

    <div>
      <h4 class="text-sm font-semibold text-surface-900 dark:text-white mb-3">…and when you press Ctrl+C</h4>
      <ol class="space-y-2">
        {ctrlC.map((s, i) => (
          <li class="flex gap-3 items-start">
            <span class="flex-shrink-0 w-7 h-7 rounded-full bg-red-600 text-white text-xs font-bold flex items-center justify-center">{String.fromCharCode(65 + i)}</span>
            <div class="flex-1 rounded-lg border border-red-200 dark:border-red-900 px-3 py-2 bg-red-50 dark:bg-red-950/30">
              <span class="font-semibold text-sm text-surface-900 dark:text-white">{s.who}</span>
              <p class="text-xs text-surface-700 dark:text-surface-300 mt-0.5">{s.what}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="mt-4 text-xs text-surface-600 dark:text-surface-400">
        Run <strong>ctrl-c-path.c</strong> below to watch steps B and C happen to two processes at once.
      </p>
    </div>
  </div>
</div>
