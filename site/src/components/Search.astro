---
---

<div class="search-container">
  <button
    id="search-trigger"
    type="button"
    class="flex items-center gap-2 px-3 py-1.5 rounded-lg border border-surface-300 dark:border-surface-600 text-sm text-surface-500 dark:text-surface-400 hover:border-surface-400 dark:hover:border-surface-500 transition-colors"
    aria-label="Search"
  >
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607z" />
    </svg>
    <span class="hidden sm:inline">Search</span>
    <kbd class="hidden sm:inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-mono bg-surface-100 dark:bg-surface-700 text-surface-400 dark:text-surface-500 border border-surface-200 dark:border-surface-600">
      /
    </kbd>
  </button>

  <dialog id="search-dialog" class="fixed inset-0 z-[100] bg-transparent p-0 m-0 w-full h-full max-w-none max-h-none">
    <div class="fixed inset-0 bg-black/50 backdrop-blur-sm" id="search-backdrop"></div>
    <div class="fixed top-[10vh] left-1/2 -translate-x-1/2 w-full max-w-2xl px-4">
      <div class="bg-white dark:bg-surface-800 rounded-2xl shadow-2xl border border-surface-200 dark:border-surface-700 overflow-hidden" id="pagefind-container">
      </div>
    </div>
  </dialog>
</div>

<style>
  dialog::backdrop {
    display: none;
  }
  dialog[open] {
    display: block;
  }
  :global(#pagefind-container .pagefind-ui) {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: #059669;
    --pagefind-ui-text: #1e293b;
    --pagefind-ui-background: #ffffff;
    --pagefind-ui-border: #e2e8f0;
    --pagefind-ui-tag: #ecfdf5;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 12px;
    --pagefind-ui-font: system-ui, -apple-system, sans-serif;
  }
  :global(html.dark #pagefind-container .pagefind-ui) {
    --pagefind-ui-text: #e2e8f0;
    --pagefind-ui-background: #1e293b;
    --pagefind-ui-border: #334155;
    --pagefind-ui-tag: #064e3b;
  }
  :global(#pagefind-container .pagefind-ui__search-input) {
    padding: 16px 20px !important;
    font-size: 16px !important;
  }
</style>

<script is:inline>
  (function() {
    var trigger = document.getElementById('search-trigger');
    var dialog = document.getElementById('search-dialog');
    var backdrop = document.getElementById('search-backdrop');
    var container = document.getElementById('pagefind-container');
    var loaded = false;

    function openSearch() {
      dialog.showModal();
      if (!loaded) {
        loaded = true;
        var script = document.createElement('script');
        script.src = '/pagefind/pagefind-ui.js';
        script.onload = function() {
          new window.PagefindUI({
            element: container,
            showSubResults: true,
            showImages: false,
            autofocus: true,
          });
          var input = container.querySelector('input');
          if (input) input.focus();
        };
        script.onerror = function() {
          container.innerHTML = '<div style="padding:2rem;text-align:center;color:#94a3b8;">Search is available in the production build.<br><code style="font-size:0.8em;">npm run build && npm run preview</code></div>';
        };
        document.head.appendChild(script);
        var css = document.createElement('link');
        css.rel = 'stylesheet';
        css.href = '/pagefind/pagefind-ui.css';
        document.head.appendChild(css);
      }
      setTimeout(function() {
        var input = container.querySelector('input');
        if (input) input.focus();
      }, 200);
    }

    function closeSearch() {
      dialog.close();
    }

    trigger.addEventListener('click', openSearch);
    backdrop.addEventListener('click', closeSearch);

    document.addEventListener('keydown', function(e) {
      if (e.key === '/' && !dialog.open && !e.target.matches('input, textarea')) {
        e.preventDefault();
        openSearch();
      }
      if (e.key === 'Escape' && dialog.open) {
        closeSearch();
      }
    });
  })();
</script>
