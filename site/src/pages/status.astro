---
import BaseLayout from '../layouts/BaseLayout.astro';
import { lessons } from '../data/os-lessons';
// slug -> "Lesson 02 · Basic Forks", for the most-used lessons list
const pageNames = Object.fromEntries([
  ...lessons.map((l) => [l.slug, `Lesson ${l.number} · ${l.title}`]),
  ['intro', 'Intro lecture (slides)'],
  ['other', 'Other / unknown page'],
]);
---

<BaseLayout title="System Status" currentPath="">
  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="text-3xl font-bold text-surface-900 dark:text-white mb-2">System Status</h1>
    <p class="text-surface-600 dark:text-surface-400 mb-10">Real-time health of the CS Lectures platform.</p>

    <div class="space-y-6">
      {/* Static Site */}
      <div class="card p-6">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-3">
            <div class="w-3 h-3 rounded-full bg-green-500"></div>
            <h2 class="text-lg font-semibold text-surface-900 dark:text-white">Static Site</h2>
          </div>
          <span class="text-xs text-green-700 dark:text-green-300 font-medium bg-green-100 dark:bg-green-900/30 px-2 py-1 rounded-full">Operational</span>
        </div>
        <div class="text-sm text-surface-600 dark:text-surface-400">
          Hosted on Cloudflare Pages — global CDN, no server required.
        </div>
      </div>

      {/* Terminal Server */}
      <div class="card p-6" id="terminal-status">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-3">
            <div class="w-3 h-3 rounded-full bg-surface-300 dark:bg-surface-600 status-dot"></div>
            <h2 class="text-lg font-semibold text-surface-900 dark:text-white">Terminal Server</h2>
          </div>
          <span class="status-badge text-xs font-medium px-2 py-1 rounded-full bg-surface-200 dark:bg-surface-700 text-surface-500">Checking...</span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-4">
          <div class="bg-surface-50 dark:bg-surface-900 rounded-xl p-4 text-center border-t-2 border-primary-500">
            <svg class="w-5 h-5 text-primary-500 mb-2 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>
            <div class="text-2xl font-bold text-surface-900 dark:text-white" id="stat-sessions">-</div>
            <div class="text-xs text-surface-500 mt-1">Active Sessions</div>
          </div>
          <div class="bg-surface-50 dark:bg-surface-900 rounded-xl p-4 text-center border-t-2 border-primary-500">
            <svg class="w-5 h-5 text-primary-500 mb-2 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 01-3-3m3 3a3 3 0 100 6h13.5a3 3 0 100-6m-16.5-3a3 3 0 013-3h13.5a3 3 0 013 3m-19.5 0a4.5 4.5 0 01.9-2.7L5.737 5.1a3.375 3.375 0 012.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 01.9 2.7m0 0a3 3 0 01-3 3m0 3h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008zm-3 6h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008z" /></svg>
            <div class="text-2xl font-bold text-surface-900 dark:text-white" id="stat-max">-</div>
            <div class="text-xs text-surface-500 mt-1">Awake Containers</div>
          </div>
          <div class="bg-surface-50 dark:bg-surface-900 rounded-xl p-4 text-center border-t-2 border-primary-500">
            <svg class="w-5 h-5 text-primary-500 mb-2 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <div class="text-2xl font-bold text-surface-900 dark:text-white" id="stat-served">-</div>
            <div class="text-xs text-surface-500 mt-1">Total Served</div>
          </div>
          <div class="bg-surface-50 dark:bg-surface-900 rounded-xl p-4 text-center border-t-2 border-primary-500">
            <svg class="w-5 h-5 text-primary-500 mb-2 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <div class="text-2xl font-bold text-surface-900 dark:text-white" id="stat-uptime">-</div>
            <div class="text-xs text-surface-500 mt-1">Uptime</div>
          </div>
        </div>

        {/* Session capacity bar */}
        <div class="mb-4">
          <div class="flex justify-between text-xs text-surface-500 dark:text-surface-400 mb-1">
            <span>Student capacity (awake containers)</span>
            <span id="capacity-label">-</span>
          </div>
          <div class="w-full h-2 rounded-full bg-surface-200 dark:bg-surface-700 overflow-hidden">
            <div id="capacity-bar" class="h-full rounded-full bg-primary-500 transition-all duration-500" style="width: 0%"></div>
          </div>
        </div>

        {/* One row per container — read without waking sleeping ones */}
        <ul id="container-list" class="divide-y divide-surface-200 dark:divide-surface-700 mb-4 text-sm"></ul>

        <div class="text-sm text-surface-600 dark:text-surface-400">
          Cloudflare Containers — three shared student sandboxes plus the lecturer's reserved one.
          Each sleeps when idle and wakes on the next Run (a few seconds). Checking this page never wakes them.
          <br />Idle session timeout: <span id="stat-timeout">-</span>
        </div>

        <div class="mt-4 text-xs text-surface-500 dark:text-surface-400" id="last-checked">Last checked: never</div>
      </div>

      {/* Usage — anonymous counts of terminals opened */}
      <div class="card p-6" id="usage">
        <div class="flex items-center justify-between mb-1">
          <h2 class="text-lg font-semibold text-surface-900 dark:text-white">Usage</h2>
          <span class="text-xs text-surface-500 dark:text-surface-400" id="usage-day"></span>
        </div>
        <p class="text-sm text-surface-600 dark:text-surface-400 mb-4">
          Terminals opened by students (Run, Run pair or the full terminal). Anonymous — no names, no IP addresses.
        </p>
        <div id="usage-empty" class="hidden text-sm text-surface-600 dark:text-surface-400"></div>
        <div id="usage-body" class="hidden">
          <div class="grid grid-cols-3 gap-4 mb-5">
            <div class="bg-surface-50 dark:bg-surface-900 rounded-xl p-4 text-center border-t-2 border-primary-500">
              <div class="text-2xl font-bold text-surface-900 dark:text-white" id="u-today">-</div>
              <div class="text-xs text-surface-500 dark:text-surface-400 mt-1">Today</div>
            </div>
            <div class="bg-surface-50 dark:bg-surface-900 rounded-xl p-4 text-center border-t-2 border-primary-500">
              <div class="text-2xl font-bold text-surface-900 dark:text-white" id="u-week">-</div>
              <div class="text-xs text-surface-500 dark:text-surface-400 mt-1">Last 7 days</div>
            </div>
            <div class="bg-surface-50 dark:bg-surface-900 rounded-xl p-4 text-center border-t-2 border-primary-500">
              <div class="text-2xl font-bold text-surface-900 dark:text-white" id="u-month">-</div>
              <div class="text-xs text-surface-500 dark:text-surface-400 mt-1">Last 30 days</div>
            </div>
          </div>

          <div class="text-xs text-surface-500 dark:text-surface-400 mb-1">Last 30 days, per day</div>
          <div id="u-bars" class="flex items-end gap-[3px] h-24 mb-1 border-b border-surface-200 dark:border-surface-700" role="img" aria-label="Terminals opened per day"></div>
          <div class="flex justify-between text-[11px] text-surface-500 dark:text-surface-400 mb-5"><span id="u-first"></span><span>today</span></div>

          <div class="grid sm:grid-cols-2 gap-6">
            <div>
              <div class="text-sm font-medium text-surface-800 dark:text-surface-200 mb-2">Most used (30 days)</div>
              <ol id="u-pages" class="space-y-1.5 text-sm"></ol>
            </div>
            <div class="text-sm text-surface-700 dark:text-surface-300 space-y-1.5">
              <div class="font-medium text-surface-800 dark:text-surface-200 mb-2">Breakdown (30 days)</div>
              <div id="u-kinds"></div>
              <div>Your presenter runs: <span class="font-mono" id="u-presenter">-</span> <span class="text-surface-500 dark:text-surface-400">(not counted above)</span></div>
            </div>
          </div>
        </div>
      </div>

      {/* Cost Info */}
      <div class="card p-6">
        <h2 class="text-lg font-semibold text-surface-900 dark:text-white mb-3">Cost Structure</h2>
        <div class="space-y-2 text-sm text-surface-600 dark:text-surface-400">
          <div class="flex justify-between">
            <span>Static site hosting</span>
            <span class="font-mono text-surface-900 dark:text-white">Free</span>
          </div>
          <div class="flex justify-between">
            <span>Workers Paid plan (base)</span>
            <span class="font-mono text-surface-900 dark:text-white">$5/mo</span>
          </div>
          <div class="flex justify-between">
            <span>Container CPU (active only)</span>
            <span class="font-mono text-surface-900 dark:text-white">$0.00002/vCPU-sec</span>
          </div>
          <div class="flex justify-between">
            <span>Free tier included</span>
            <span class="font-mono text-surface-900 dark:text-white">375 vCPU-min</span>
          </div>
          <div class="border-t border-surface-200 dark:border-surface-700 pt-2 mt-2 flex justify-between font-medium text-surface-900 dark:text-white">
            <span>Estimated monthly</span>
            <span>~$5-7</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ PAGE_NAMES: pageNames }}>
  (function() {
    var meta = document.querySelector('meta[name="terminal-url"]');
    var TERMINAL_URL = (meta && meta.content ? meta.content : 'wss://cs-lectures-terminal.yaniv242.workers.dev').replace(/^ws/, 'http').replace(/\/$/, '');
    var LABELS = { presenter: 'Lecturer (reserved)' };

    function formatUptime(seconds) {
      if (seconds < 60) return seconds + 's';
      if (seconds < 3600) return Math.floor(seconds / 60) + 'm ' + (seconds % 60) + 's';
      var h = Math.floor(seconds / 3600);
      var m = Math.floor((seconds % 3600) / 60);
      return h + 'h ' + m + 'm';
    }

    function setBadge(tone, text) {
      var tones = {
        ok: 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300',
        idle: 'bg-surface-200 dark:bg-surface-700 text-surface-700 dark:text-surface-200',
        bad: 'bg-yellow-100 dark:bg-yellow-900/30 text-yellow-800 dark:text-yellow-300'
      };
      var dots = { ok: 'bg-green-500', idle: 'bg-surface-400', bad: 'bg-yellow-500' };
      document.querySelector('.status-dot').className = 'w-3 h-3 rounded-full status-dot ' + dots[tone];
      var badge = document.querySelector('.status-badge');
      badge.className = 'status-badge text-xs font-medium px-2 py-1 rounded-full ' + tones[tone];
      badge.textContent = text;
    }

    function row(c) {
      var li = document.createElement('li');
      li.id = 'container-' + c.name;
      li.dataset.state = c.state;
      li.className = 'flex items-center justify-between py-2';
      var awake = c.state === 'awake';
      var name = document.createElement('span');
      name.className = 'flex items-center gap-2 font-mono text-surface-800 dark:text-surface-200';
      name.innerHTML = '<span class="w-2 h-2 rounded-full ' + (awake ? 'bg-green-500' : 'bg-surface-400') + '"></span>';
      name.appendChild(document.createTextNode(LABELS[c.name] || c.name));
      var info = document.createElement('span');
      info.className = 'container-info text-surface-600 dark:text-surface-400';
      info.textContent = awake
        ? 'Awake · ' + c.activeSessions + '/' + c.maxSessions + ' sessions · up ' + formatUptime(c.uptimeSeconds || 0)
        : c.state === 'starting' ? 'Starting…' : 'Asleep';
      li.appendChild(name);
      li.appendChild(info);
      return li;
    }

    function update() {
      fetch(TERMINAL_URL + '/status')
        .then(function(r) { return r.json(); })
        .then(function(data) {
          var all = data.containers || [];
          var awake = all.filter(function(c) { return c.state === 'awake'; });
          var students = awake.filter(function(c) { return c.name !== 'presenter'; });
          var active = students.reduce(function(n, c) { return n + (c.activeSessions || 0); }, 0);
          var max = students.reduce(function(n, c) { return n + (c.maxSessions || 0); }, 0);
          setBadge(awake.length ? 'ok' : 'idle', awake.length ? 'Operational' : 'Asleep (wakes on demand)');
          document.getElementById('stat-sessions').textContent = awake.reduce(function(n, c) { return n + (c.activeSessions || 0); }, 0);
          document.getElementById('stat-max').textContent = awake.length + ' / ' + all.length;
          document.getElementById('stat-served').textContent = awake.reduce(function(n, c) { return n + (c.totalServed || 0); }, 0);
          document.getElementById('stat-uptime').textContent = awake.length ? formatUptime(Math.max.apply(null, awake.map(function(c) { return c.uptimeSeconds || 0; }))) : '-';
          document.getElementById('stat-timeout').textContent = '3 minutes';
          var pct = max ? Math.round((active / max) * 100) : 0;
          var bar = document.getElementById('capacity-bar');
          bar.style.width = pct + '%';
          bar.className = 'h-full rounded-full transition-all duration-500 ' + (pct > 80 ? 'bg-red-500' : pct > 50 ? 'bg-yellow-500' : 'bg-primary-500');
          document.getElementById('capacity-label').textContent = max ? active + ' / ' + max : 'no student container awake';
          var list = document.getElementById('container-list');
          list.replaceChildren.apply(list, all.map(row));
          document.getElementById('last-checked').textContent = 'Last checked: ' + new Date().toLocaleTimeString();
        })
        .catch(function() {
          setBadge('bad', 'Unreachable');
          document.getElementById('last-checked').textContent = 'Last checked: ' + new Date().toLocaleTimeString() + ' (could not reach the terminal service)';
        });
    }

    // ---------- anonymous usage ----------
    var KIND_NAMES = { example: 'Run on an example', pair: 'Run pair', lesson: 'Full lesson terminal', other: 'Other' };
    function show(id, on) { document.getElementById(id).classList.toggle('hidden', !on); }
    function updateUsage() {
      fetch(TERMINAL_URL + '/usage')
        .then(function(r) { if (!r.ok) throw new Error(r.status); return r.json(); })
        .then(function(u) {
          show('usage-body', true); show('usage-empty', false);
          document.getElementById('usage-day').textContent = 'Israel date ' + u.today;
          document.getElementById('u-today').textContent = u.students.today;
          document.getElementById('u-week').textContent = u.students.week;
          document.getElementById('u-month').textContent = u.students.month;
          document.getElementById('u-presenter').textContent = u.presenter.month;
          // 30 bars, oldest first; days without use are 0
          var perDay = {};
          u.daily.forEach(function(d) { if (d.who === 'student') perDay[d.day] = (perDay[d.day] || 0) + d.n; });
          var days = [];
          for (var i = 29; i >= 0; i--) days.push(new Date(Date.now() - i * 86400000).toLocaleDateString('en-CA', { timeZone: 'Asia/Jerusalem' }));
          var max = Math.max.apply(null, days.map(function(d) { return perDay[d] || 0; }).concat([1]));
          var bars = document.getElementById('u-bars');
          bars.replaceChildren.apply(bars, days.map(function(d) {
            var b = document.createElement('div');
            var n = perDay[d] || 0;
            b.className = 'flex-1 rounded-t ' + (n ? 'bg-primary-500' : 'bg-surface-200 dark:bg-surface-700');
            b.style.height = (n ? Math.max(6, Math.round(n / max * 100)) : 3) + '%';
            b.title = d + ': ' + n;
            return b;
          }));
          document.getElementById('u-first').textContent = days[0];
          var pages = document.getElementById('u-pages');
          pages.replaceChildren.apply(pages, u.topPages.length ? u.topPages.map(function(p) {
            var li = document.createElement('li');
            li.className = 'flex justify-between gap-3';
            var name = document.createElement('span'); name.className = 'truncate text-surface-700 dark:text-surface-300';
            name.textContent = PAGE_NAMES[p.page] || p.page;
            var n = document.createElement('span'); n.className = 'font-mono text-surface-900 dark:text-white'; n.textContent = p.n;
            li.appendChild(name); li.appendChild(n); return li;
          }) : [Object.assign(document.createElement('li'), { className: 'text-surface-500 dark:text-surface-400', textContent: 'No student terminals yet' })]);
          var kinds = document.getElementById('u-kinds');
          kinds.replaceChildren.apply(kinds, u.kinds.map(function(k) {
            var d = document.createElement('div');
            d.textContent = (KIND_NAMES[k.kind] || k.kind) + ': ' + k.n;
            return d;
          }));
        })
        .catch(function() {
          show('usage-body', false); show('usage-empty', true);
          document.getElementById('usage-empty').textContent = 'Usage numbers are collected by the live terminal service (not available here).';
        });
    }
    updateUsage();
    setInterval(updateUsage, 60000);

    update();
    setInterval(update, 10000);
  })();
</script>
