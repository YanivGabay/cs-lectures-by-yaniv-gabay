---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="System Status" currentPath="">
  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="text-3xl font-bold text-surface-900 dark:text-white mb-2">System Status</h1>
    <p class="text-surface-600 dark:text-surface-400 mb-10">Real-time health of the CS Lectures platform.</p>

    <div class="space-y-6">
      {/* Static Site */}
      <div class="card p-6">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-3">
            <div class="w-3 h-3 rounded-full bg-green-500"></div>
            <h2 class="text-lg font-semibold text-surface-900 dark:text-white">Static Site</h2>
          </div>
          <span class="text-xs text-green-700 dark:text-green-300 font-medium bg-green-100 dark:bg-green-900/30 px-2 py-1 rounded-full">Operational</span>
        </div>
        <div class="text-sm text-surface-600 dark:text-surface-400">
          Hosted on Cloudflare Pages — global CDN, no server required.
        </div>
      </div>

      {/* Terminal Server */}
      <div class="card p-6" id="terminal-status">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-3">
            <div class="w-3 h-3 rounded-full bg-surface-300 dark:bg-surface-600 status-dot"></div>
            <h2 class="text-lg font-semibold text-surface-900 dark:text-white">Terminal Server</h2>
          </div>
          <span class="status-badge text-xs font-medium px-2 py-1 rounded-full bg-surface-200 dark:bg-surface-700 text-surface-500">Checking...</span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-4">
          <div class="bg-surface-50 dark:bg-surface-900 rounded-xl p-4 text-center border-t-2 border-primary-500">
            <svg class="w-5 h-5 text-primary-500 mb-2 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>
            <div class="text-2xl font-bold text-surface-900 dark:text-white" id="stat-sessions">-</div>
            <div class="text-xs text-surface-500 mt-1">Active Sessions</div>
          </div>
          <div class="bg-surface-50 dark:bg-surface-900 rounded-xl p-4 text-center border-t-2 border-primary-500">
            <svg class="w-5 h-5 text-primary-500 mb-2 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 01-3-3m3 3a3 3 0 100 6h13.5a3 3 0 100-6m-16.5-3a3 3 0 013-3h13.5a3 3 0 013 3m-19.5 0a4.5 4.5 0 01.9-2.7L5.737 5.1a3.375 3.375 0 012.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 01.9 2.7m0 0a3 3 0 01-3 3m0 3h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008zm-3 6h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008z" /></svg>
            <div class="text-2xl font-bold text-surface-900 dark:text-white" id="stat-max">-</div>
            <div class="text-xs text-surface-500 mt-1">Max Sessions</div>
          </div>
          <div class="bg-surface-50 dark:bg-surface-900 rounded-xl p-4 text-center border-t-2 border-primary-500">
            <svg class="w-5 h-5 text-primary-500 mb-2 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <div class="text-2xl font-bold text-surface-900 dark:text-white" id="stat-served">-</div>
            <div class="text-xs text-surface-500 mt-1">Total Served</div>
          </div>
          <div class="bg-surface-50 dark:bg-surface-900 rounded-xl p-4 text-center border-t-2 border-primary-500">
            <svg class="w-5 h-5 text-primary-500 mb-2 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <div class="text-2xl font-bold text-surface-900 dark:text-white" id="stat-uptime">-</div>
            <div class="text-xs text-surface-500 mt-1">Uptime</div>
          </div>
        </div>

        {/* Session capacity bar */}
        <div class="mb-4">
          <div class="flex justify-between text-xs text-surface-500 mb-1">
            <span>Session Capacity</span>
            <span id="capacity-label">-</span>
          </div>
          <div class="w-full h-2 rounded-full bg-surface-200 dark:bg-surface-700 overflow-hidden">
            <div id="capacity-bar" class="h-full rounded-full bg-primary-500 transition-all duration-500" style="width: 0%"></div>
          </div>
        </div>

        <div class="text-sm text-surface-600 dark:text-surface-400">
          Cloudflare Container — scales to zero when idle, auto-restarts on demand (~3s cold start).
          <br />Session timeout: <span id="stat-timeout">-</span>
        </div>

        <div class="mt-4 text-xs text-surface-500 dark:text-surface-400" id="last-checked">Last checked: never</div>
      </div>

      {/* Cost Info */}
      <div class="card p-6">
        <h2 class="text-lg font-semibold text-surface-900 dark:text-white mb-3">Cost Structure</h2>
        <div class="space-y-2 text-sm text-surface-600 dark:text-surface-400">
          <div class="flex justify-between">
            <span>Static site hosting</span>
            <span class="font-mono text-surface-900 dark:text-white">Free</span>
          </div>
          <div class="flex justify-between">
            <span>Workers Paid plan (base)</span>
            <span class="font-mono text-surface-900 dark:text-white">$5/mo</span>
          </div>
          <div class="flex justify-between">
            <span>Container CPU (active only)</span>
            <span class="font-mono text-surface-900 dark:text-white">$0.00002/vCPU-sec</span>
          </div>
          <div class="flex justify-between">
            <span>Free tier included</span>
            <span class="font-mono text-surface-900 dark:text-white">375 vCPU-min</span>
          </div>
          <div class="border-t border-surface-200 dark:border-surface-700 pt-2 mt-2 flex justify-between font-medium text-surface-900 dark:text-white">
            <span>Estimated monthly</span>
            <span>~$5-7</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function() {
    var TERMINAL_URL = 'https://cs-lectures-terminal.yaniv242.workers.dev';

    function formatUptime(seconds) {
      if (seconds < 60) return seconds + 's';
      if (seconds < 3600) return Math.floor(seconds / 60) + 'm ' + (seconds % 60) + 's';
      var h = Math.floor(seconds / 3600);
      var m = Math.floor((seconds % 3600) / 60);
      return h + 'h ' + m + 'm';
    }

    function update() {
      fetch(TERMINAL_URL + '/health')
        .then(function(r) { return r.json(); })
        .then(function(data) {
          document.querySelector('.status-dot').className = 'w-3 h-3 rounded-full bg-green-500 status-dot';
          document.querySelector('.status-badge').className = 'status-badge text-xs font-medium px-2 py-1 rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300';
          document.querySelector('.status-badge').textContent = 'Operational';

          document.getElementById('stat-sessions').textContent = data.activeSessions;
          document.getElementById('stat-max').textContent = data.maxSessions;
          document.getElementById('stat-served').textContent = data.totalServed || '0';
          document.getElementById('stat-uptime').textContent = formatUptime(data.uptimeSeconds || 0);
          document.getElementById('stat-timeout').textContent = Math.floor((data.sessionTimeoutMs || 180000) / 1000) + 's';

          var pct = Math.round((data.activeSessions / data.maxSessions) * 100);
          document.getElementById('capacity-bar').style.width = pct + '%';
          document.getElementById('capacity-label').textContent = data.activeSessions + ' / ' + data.maxSessions;

          if (pct > 80) document.getElementById('capacity-bar').className = 'h-full rounded-full bg-red-500 transition-all duration-500';
          else if (pct > 50) document.getElementById('capacity-bar').className = 'h-full rounded-full bg-yellow-500 transition-all duration-500';
          else document.getElementById('capacity-bar').className = 'h-full rounded-full bg-primary-500 transition-all duration-500';

          document.getElementById('last-checked').textContent = 'Last checked: ' + new Date().toLocaleTimeString();
        })
        .catch(function() {
          document.querySelector('.status-dot').className = 'w-3 h-3 rounded-full bg-yellow-500 status-dot';
          document.querySelector('.status-badge').className = 'status-badge text-xs font-medium px-2 py-1 rounded-full bg-yellow-100 dark:bg-yellow-900/30 text-yellow-800 dark:text-yellow-300';
          document.querySelector('.status-badge').textContent = 'Sleeping (starts on demand)';
          document.getElementById('stat-sessions').textContent = '0';
          document.getElementById('last-checked').textContent = 'Last checked: ' + new Date().toLocaleTimeString();
        });
    }

    update();
    setInterval(update, 10000);
  })();
</script>
