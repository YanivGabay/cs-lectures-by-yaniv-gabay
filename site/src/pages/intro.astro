---
// First-lecture intro deck: who I am, what the course covers, a live fork() demo, then C++ -> C.
// Full screen, no site header. Keys: → ← / PageDown PageUp / Space (clickers), F fullscreen, Home/End.
import '../styles/global.css';
import CodeBlock from '../components/CodeBlock.astro';
import { lessons } from '../data/os-lessons';

const phases = [
  { name: 'Foundation', blurb: 'C for C++ programmers', color: '#60a5fa' },
  { name: 'Processes', blurb: 'fork · exec · wait · signals', color: '#34d399' },
  { name: 'IPC', blurb: 'pipes · FIFOs · queues · shared memory · sockets', color: '#fb923c' },
  { name: 'Threads', blurb: 'pthreads · mutex · condition variables', color: '#f87171' },
  { name: 'Exam Prep', blurb: 'past exams, solved together', color: '#c084fc' },
  { name: 'Behind the Scenes', blurb: 'how this very site runs your code', color: '#22d3ee' },
].map((p) => ({ ...p, lessons: lessons.filter((l) => l.phase === p.name).length }));
const totalExamples = lessons.reduce((n, l) => n + l.examples.length, 0);

const syscalls = ['printf()', 'fork()', 'exec()', 'wait()', 'signal()', 'sigaction()', 'pipe()', 'mkfifo()',
  'msgsnd()', 'shmget()', 'socket()', 'select()', 'pthread_create()', 'pthread_mutex_lock()', 'pthread_cond_wait()', 'sem_wait()'];

const cppCode = `#include <iostream>
using namespace std;

int main() {
    int n;
    cout << "Enter a number: ";
    cin >> n;
    cout << "You entered " << n << endl;
}`;

const cCode = `#include <stdio.h>

int main(void) {
    int n;
    printf("Enter a number: ");
    scanf("%d", &n);
    printf("You entered %d\\n", n);
    return 0;
}`;

const demo = `#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>

int main(void)
{
    printf("Before fork: pid %d\\n", getpid());
    fflush(stdout);

    pid_t pid = fork();   // 1 in, 2 out

    if (pid == 0)
        printf("[Child]  pid %d, parent %d\\n",
               getpid(), getppid());
    else {
        wait(NULL);       // wait for the child
        printf("[Parent] pid %d, child %d\\n",
               getpid(), pid);
    }
    return 0;
}
`;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Operating Systems & C — first lecture" />
    <meta name="terminal-url" content={import.meta.env.PUBLIC_TERMINAL_URL || ''} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet" />
    <title>Welcome | Operating Systems & C</title>
  </head>
  <body class="deck-body">
