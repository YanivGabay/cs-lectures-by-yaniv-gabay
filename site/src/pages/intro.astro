    <nav class="deck-ui" aria-label="Slide controls">
      <button class="d-prev" aria-label="Previous slide">◀</button>
      <span class="d-pos"></span>
      <button class="d-next" aria-label="Next slide">▶</button>
      <button class="d-fs" aria-label="Full screen" title="Full screen (F)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg></button>
    </nav>
    <div class="d-progress"><div></div></div>

    <script>
      const slides = [...document.querySelectorAll<HTMLElement>('.slide')];
      const pos = document.querySelector('.d-pos')!;
      const bar = document.querySelector<HTMLElement>('.d-progress > div')!;
      let current = -1;

      // Title-slide terminal types itself, then shows its output
      function typeTerminal(slide: HTMLElement) {
        const typed = slide.querySelector<HTMLElement>('.typed');
        if (!typed) return;
        const text = typed.dataset.text || '';
        const out = slide.querySelector<HTMLElement>('.out');
        typed.textContent = '';
        out?.classList.remove('show');
        let i = 0;
        const tick = () => {
          if (current !== slides.indexOf(slide)) return;
          typed.textContent = text.slice(0, ++i);
          if (i < text.length) setTimeout(tick, 45 + Math.random() * 40);
          else setTimeout(() => out?.classList.add('show'), 450);
        };
        setTimeout(tick, 1400);
      }

      function go(i: number) {
        const n = Math.max(0, Math.min(i, slides.length - 1));
        if (n === current) return;
        slides.forEach((s, k) => {
          s.classList.toggle('active', k === n);
          s.classList.toggle('before', k < n);
          s.setAttribute('aria-hidden', String(k !== n));
        });
        current = n;
        pos.textContent = `${n + 1} / ${slides.length}`;
        bar.style.width = `${((n + 1) / slides.length) * 100}%`;
        document.title = `${slides[n].dataset.title} | Operating Systems & C`;
        history.replaceState(null, '', `#${n + 1}`);
        typeTerminal(slides[n]);
      }

      const fullscreen = () => {
        if (document.fullscreenElement) document.exitFullscreen();
        else document.documentElement.requestFullscreen?.().catch(() => {});
      };

      window.addEventListener('keydown', (e) => {
        // the live terminal and code editor own the keyboard while focused
        if ((e.target as HTMLElement).closest?.('.xterm, .CodeMirror, input, textarea')) {
          if (e.key !== 'PageDown' && e.key !== 'PageUp') return;
        }
        const k = e.key;
        if (k === 'ArrowRight' || k === 'PageDown' || k === ' ') go(current + 1);
        else if (k === 'ArrowLeft' || k === 'PageUp') go(current - 1);
        else if (k === 'Home') go(0);
        else if (k === 'End') go(slides.length - 1);
        else if (k === 'f' || k === 'F') fullscreen();
        else return;
        e.preventDefault();
        e.stopImmediatePropagation();
      }, true); // capture phase: a clicker's PageDown must work even while the terminal has focus

      document.querySelector('.d-next')!.addEventListener('click', () => go(current + 1));
      document.querySelector('.d-prev')!.addEventListener('click', () => go(current - 1));
      document.querySelector('.d-fs')!.addEventListener('click', fullscreen);

      // Swipe on touch screens
      let x0 = 0;
      window.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
      window.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - x0;
        if (Math.abs(dx) > 60 && !(e.target as HTMLElement).closest('.xterm, pre, .code-scroll')) go(current + (dx < 0 ? 1 : -1));
      });

      window.addEventListener('hashchange', () => go((Number(location.hash.slice(1)) || 1) - 1));
      go((Number(location.hash.slice(1)) || 1) - 1);
    </script>

    <style is:global>
      .deck-body {
        margin: 0;
        height: 100vh;
        overflow: hidden;
        background: #050816;
        color: #e2e8f0;
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      }

      /* Moving background */
      .deck-bg { position: fixed; inset: 0; overflow: hidden; z-index: 0; }
      .blob { position: absolute; width: 46vw; height: 46vw; border-radius: 50%; filter: blur(90px); opacity: .32; animation: drift 22s ease-in-out infinite alternate; }
      .b1 { background: #10b981; top: -15vw; left: -10vw; }
      .b2 { background: #0891b2; bottom: -20vw; right: -12vw; animation-duration: 28s; }
      .b3 { background: #7c3aed; top: 30%; left: 45%; width: 30vw; height: 30vw; opacity: .18; animation-duration: 34s; }
      @keyframes drift { to { transform: translate(8vw, 6vh) scale(1.15); } }
      .grid-lines { position: absolute; inset: 0; background-image: linear-gradient(rgba(148,163,184,.06) 1px, transparent 1px), linear-gradient(90deg, rgba(148,163,184,.06) 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%); }

      /* Slides */
      #deck { position: relative; z-index: 1; height: 100vh; overflow: hidden; }
      .slide { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; padding: 4vh 6vw 9vh; box-sizing: border-box; overflow-y: auto; opacity: 0; visibility: hidden; transform: translateX(6vw) scale(.98); transition: opacity .6s ease, transform .7s cubic-bezier(.2,.8,.2,1), visibility .6s; }
      .slide.before { transform: translateX(-6vw) scale(.98); }
      .slide.active { opacity: 1; visibility: visible; transform: none; }
      .center { text-align: center; max-width: 1100px; }
      .wide { width: min(1200px, 100%); }

      /* Staggered entrance: every .a fades up when its slide becomes active */
      .slide .a { opacity: 0; transform: translateY(26px); }
      .slide.active .a { animation: rise .8s cubic-bezier(.2,.8,.2,1) forwards; animation-delay: calc(var(--d, 0) * 0.16s + .15s); }
      @keyframes rise { to { opacity: 1; transform: none; } }
      .slide .pop { opacity: 0; transform: scale(.4) rotate(-6deg); }
      .slide.active .pop { animation: pop .55s cubic-bezier(.3,1.6,.5,1) forwards; animation-delay: calc(var(--d, 0) * 0.16s); }
      @keyframes pop { to { opacity: 1; transform: none; } }

      .kicker { text-transform: uppercase; letter-spacing: .22em; font-size: clamp(.8rem, 1.2vw, 1rem); color: #34d399; font-weight: 700; margin: 0 0 1rem; }
      .mega { font-size: clamp(2.6rem, 6.8vw, 6.2rem); line-height: 1.02; margin: 0; font-weight: 800; letter-spacing: -.02em; color: #fff; }
      .title { font-size: clamp(2rem, 4.2vw, 3.8rem); line-height: 1.1; margin: 0 0 1.2rem; font-weight: 800; color: #fff; letter-spacing: -.01em; }
      .title code, .lead code { font-family: var(--font-mono); color: #34d399; }
      .lead { font-size: clamp(1.15rem, 2vw, 1.7rem); color: #cbd5e1; margin: 0 0 1.5rem; }
      .note { font-size: clamp(1rem, 1.6vw, 1.35rem); color: #94a3b8; margin-top: 2rem; }
      .he { font-size: clamp(1.4rem, 2.6vw, 2.2rem); color: #a7f3d0; margin: 1.2rem 0; font-weight: 600; }
      .he-inline { color: #a7f3d0; }
      .grad { background: linear-gradient(90deg, #34d399, #22d3ee, #a78bfa, #34d399); background-size: 300% 100%; -webkit-background-clip: text; background-clip: text; color: transparent; animation: shine 6s linear infinite; }
      @keyframes shine { to { background-position: 300% 0; } }

      /* Title terminal */
      .term { margin: 2.5rem auto 0; max-width: 640px; text-align: left; background: rgba(15,23,42,.85); border: 1px solid #1e293b; border-radius: 14px; box-shadow: 0 30px 80px -20px rgba(16,185,129,.35); overflow: hidden; }
      .term-bar { display: flex; gap: 7px; padding: 10px 14px; background: #0b1222; }
      .term-bar span { width: 12px; height: 12px; border-radius: 50%; background: #ef4444; }
      .term-bar span:nth-child(2) { background: #eab308; } .term-bar span:nth-child(3) { background: #22c55e; }
      .term pre { margin: 0; padding: 18px 20px 22px; font-family: var(--font-mono); font-size: clamp(.95rem, 1.6vw, 1.3rem); color: #e2e8f0; white-space: pre-wrap; min-height: 4.5em; }
      .prompt { color: #34d399; }
      .caret { display: inline-block; width: .6em; height: 1.1em; background: #22d3ee; vertical-align: text-bottom; animation: blink 1s steps(1) infinite; }
      @keyframes blink { 50% { opacity: 0; } }
      .out { color: #a7f3d0; opacity: 0; transition: opacity .4s; } .out.show { opacity: 1; }

      /* Timeline */
      .timeline { list-style: none; padding: 0; margin: 2rem 0 0; position: relative; }
      .timeline::before { content: ''; position: absolute; left: 11px; top: 8px; bottom: 8px; width: 2px; background: linear-gradient(#34d399, #22d3ee); opacity: .5; }
      .timeline li { position: relative; padding: 0 0 1.4rem 3rem; display: flex; flex-direction: column; }
      .timeline b { font-size: clamp(1.2rem, 2.2vw, 1.9rem); color: #fff; }
      .timeline span:not(.dot) { font-size: clamp(1rem, 1.6vw, 1.3rem); color: #94a3b8; }
      .dot { position: absolute; left: 3px; top: 8px; width: 18px; height: 18px; border-radius: 50%; background: #0f172a; border: 3px solid #34d399; }
      .dot.glow { background: #34d399; box-shadow: 0 0 0 0 rgba(52,211,153,.7); animation: pulse 2s infinite; }
      @keyframes pulse { 70% { box-shadow: 0 0 0 16px rgba(52,211,153,0); } 100% { box-shadow: 0 0 0 0 rgba(52,211,153,0); } }

      /* Cards */
      .cards3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; margin-top: 1rem; }
      .card-x { background: rgba(15,23,42,.7); border: 1px solid #1e293b; border-radius: 18px; padding: 1.6rem; font-size: clamp(1rem, 1.5vw, 1.25rem); color: #cbd5e1; backdrop-filter: blur(6px); }
      .card-x b { display: block; color: #fff; font-size: clamp(1.15rem, 1.8vw, 1.5rem); margin-bottom: .4rem; }
      .card-x .big { font-size: clamp(3rem, 6vw, 5rem); font-weight: 800; color: #34d399; line-height: 1; margin-bottom: .4rem; }
      .card-x .ico { font-size: 2rem; color: #22d3ee; margin-bottom: .6rem; }

      /* Why + tree */
      .split { display: grid; grid-template-columns: 1.2fr 1fr; gap: 4vw; align-items: center; width: min(1250px, 100%); }
      .qs { list-style: none; padding: 0; margin: 1rem 0 0; }
      .qs li { font-size: clamp(1.1rem, 1.9vw, 1.6rem); color: #cbd5e1; padding: .55rem 0 .55rem 1.6rem; position: relative; }
      .qs li::before { content: '›'; position: absolute; left: 0; color: #34d399; font-weight: 800; }
      .qs b { color: #fff; }
      kbd { font-family: var(--font-mono); background: #1e293b; border: 1px solid #334155; border-bottom-width: 3px; border-radius: 6px; padding: 0 .4em; font-size: .9em; }
      .tree { width: 100%; max-width: 480px; }
      .tree rect { fill: rgba(16,185,129,.12); stroke: #34d399; stroke-width: 2; }
      .tree rect.child { fill: rgba(34,211,238,.12); stroke: #22d3ee; }
      .tree text { fill: #e2e8f0; font-family: var(--font-mono); font-size: 14px; text-anchor: middle; }
      .tree line { stroke: #475569; stroke-width: 2; stroke-dasharray: 140; stroke-dashoffset: 140; }
      .tree .node-group g { opacity: 0; transform-box: fill-box; transform-origin: center; transform: scale(.5); }
      .slide.active .tree line { animation: draw .7s ease forwards; animation-delay: calc(var(--d) * .25s); }
      .slide.active .tree .node-group g { animation: pop .5s cubic-bezier(.3,1.6,.5,1) forwards; animation-delay: calc(var(--d) * .25s); }
      @keyframes draw { to { stroke-dashoffset: 0; } }

      /* Roadmap */
      .road { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; }
      .road li { position: relative; background: rgba(15,23,42,.7); border: 1px solid #1e293b; border-top: 4px solid var(--c); border-radius: 16px; padding: 1.3rem 1.3rem 1.1rem 4.2rem; display: flex; flex-direction: column; gap: .2rem; }
      .road .stop { position: absolute; left: 1.1rem; top: 1.2rem; width: 2.2rem; height: 2.2rem; border-radius: 50%; display: grid; place-items: center; font-weight: 800; color: #050816; background: var(--c); }
      .road b { color: #fff; font-size: clamp(1.1rem, 1.7vw, 1.45rem); }
      .road span { color: #cbd5e1; font-size: clamp(.95rem, 1.3vw, 1.1rem); }
      .road em { color: var(--c); font-style: normal; font-weight: 700; font-size: .95rem; margin-top: .3rem; }

      /* Syscall chips */
      .chips { display: flex; flex-wrap: wrap; gap: .9rem; margin-top: 1.5rem; }
      .chips code { font-family: var(--font-mono); font-size: clamp(1rem, 1.8vw, 1.5rem); padding: .55rem 1rem; border-radius: 12px; background: rgba(16,185,129,.1); border: 1px solid rgba(52,211,153,.45); color: #a7f3d0; }
      .chips code:nth-child(3n) { background: rgba(34,211,238,.1); border-color: rgba(34,211,238,.45); color: #a5f3fc; }
      .chips code:nth-child(4n) { background: rgba(167,139,250,.1); border-color: rgba(167,139,250,.45); color: #ddd6fe; }

      /* Live demo slide: the real CodeBlock, sized for the projector */
      .demo { width: min(1150px, 100%); align-self: flex-start; padding-top: 2vh; }
      .demo .lead { margin-bottom: 1rem; }
      .demo .code-block-wrapper { background: #0d1117; }
      .demo .code-block-wrapper pre, .demo .code-block-wrapper code { font-size: clamp(.85rem, 1.15vw, 1.1rem) !important; }
      /* After Run: code on the left, terminal on the right — both visible on a projector */
      @media (min-width: 1000px) {
        .demo .code-block-wrapper:has(.terminal-container) { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; }
        .demo .code-block-wrapper:has(.terminal-container) > * { grid-column: 1; }
        .demo .code-block-wrapper:has(.terminal-container) > .terminal-slot { grid-column: 2; grid-row: 1 / span 3; align-self: start; border-left: 1px solid #1e293b; }
        /* a little shorter than the code, so the grid never stretches the code side */
        .demo .terminal-slot .terminal-target { height: min(48vh, 470px) !important; }
      }

      /* Tips */
      .tips { padding-left: 1.4rem; margin: 1.2rem 0 0; }
      .tips li { font-size: clamp(1.1rem, 1.9vw, 1.6rem); color: #cbd5e1; margin-bottom: 1.1rem; padding-left: .5rem; }
      .tips li::marker { color: #34d399; font-weight: 800; }
      .tips b { color: #fff; }
      .tips code { font-family: var(--font-mono); color: #a7f3d0; }

      /* Contact */
      .mail { display: inline-block; font-family: var(--font-mono); font-size: clamp(1.4rem, 3.4vw, 3rem); color: #34d399; text-decoration: none; padding: 1rem 2rem; border-radius: 18px; border: 2px solid rgba(52,211,153,.5); background: rgba(16,185,129,.08); margin: 1rem 0 2rem; }
      .mail:hover { background: rgba(16,185,129,.18); }

      /* C++ -> C */
      .morph { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1.5rem; align-items: center; margin-top: 2.4rem; }
      .side { position: relative; background: rgba(13,17,23,.92); border: 1px solid #1e293b; border-radius: 16px; padding: 2.2rem 1.4rem 1.2rem; }
      .side pre { margin: 0; font-family: var(--font-mono); font-size: clamp(.9rem, 1.45vw, 1.25rem); color: #e2e8f0; white-space: pre; overflow-x: auto; }
      .tag { position: absolute; top: -.9rem; left: 1.2rem; padding: .2rem .9rem; border-radius: 999px; font-weight: 800; font-size: 1rem; }
      .tag.cpp { background: #60a5fa; color: #050816; } .tag.c { background: #34d399; color: #050816; }
      .arrow { font-size: clamp(2rem, 4vw, 3.5rem); color: #34d399; }
      .slide.active .arrow { animation: rise .8s forwards, nudge 1.6s ease-in-out 1.6s infinite; animation-delay: .65s, 1.6s; }
      @keyframes nudge { 50% { transform: translateX(10px); } }
      .go { display: inline-block; margin-top: 2rem; padding: 1rem 2.2rem; border-radius: 14px; background: #10b981; color: #050816; font-weight: 800; font-size: clamp(1.1rem, 1.8vw, 1.5rem); text-decoration: none; box-shadow: 0 15px 40px -10px rgba(16,185,129,.6); }
      .go:hover { background: #34d399; }

      /* Controls */
      .deck-ui { position: fixed; right: 1.2rem; bottom: 1rem; z-index: 5; display: flex; align-items: center; gap: .5rem; font-family: var(--font-mono); color: #94a3b8; font-size: .95rem; }
      .deck-ui button { display: inline-flex; align-items: center; background: rgba(15,23,42,.8); color: #e2e8f0; border: 1px solid #334155; border-radius: 10px; padding: .35rem .7rem; cursor: pointer; }
      .deck-ui button:hover { background: #1e293b; }
      .d-progress { position: fixed; left: 0; right: 0; bottom: 0; height: 4px; background: rgba(148,163,184,.15); z-index: 5; }
      .d-progress div { height: 100%; width: 0; background: linear-gradient(90deg, #10b981, #22d3ee); transition: width .5s ease; }

      @media (max-width: 800px) {
        .cards3, .road { grid-template-columns: 1fr; }
        .split, .morph { grid-template-columns: 1fr; }
        .arrow { transform: rotate(90deg); justify-self: center; }
        .tree { max-width: 300px; justify-self: center; }
        .slide { align-items: flex-start; padding-top: 6vh; }
      }
      /* Common classroom projectors are 1280x720 / 1366x768: keep the live demo on one screen */
      @media (max-height: 880px) {
        .demo { padding-top: 0; }
        .demo .kicker { margin-bottom: .4rem; }
        .demo .title { font-size: clamp(1.6rem, 3vw, 2.4rem); margin-bottom: .4rem; }
        .demo .lead { font-size: 1.05rem; margin-bottom: .6rem; }
        .demo .code-block-wrapper pre, .demo .code-block-wrapper code { font-size: .92rem !important; line-height: 1.38 !important; }
        .demo .code-block-wrapper code .line { line-height: 1.38; }
        .demo .terminal-slot .terminal-target { height: 330px !important; }
        .slide { padding-top: 3vh; padding-bottom: 7vh; }
      }
      @media (prefers-reduced-motion: reduce) {
        .blob, .grad, .dot.glow { animation: none !important; }
        .slide, .slide .a, .slide .pop { transition: none !important; animation-duration: .01s !important; animation-delay: 0s !important; }
      }
    </style>
  </body>
</html>
