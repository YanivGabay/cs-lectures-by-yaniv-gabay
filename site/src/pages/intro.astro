      {/* 6 — The vocabulary */}
      <section class="slide" data-title="What you'll master">
        <div class="wide">
          <p class="kicker a" style="--d:0">By the end you'll use all of these</p>
          <h2 class="title a" style="--d:1">The words of the operating system</h2>
