---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LessonCard from '../../components/LessonCard.astro';
import ProgressBar from '../../components/ProgressBar.astro';
import ConceptGraph from '../../components/ConceptGraph.astro';
import { OS_COURSE, lessons } from '../../data/os-lessons';

const phases = [
  { name: 'Foundation', icon: '1', color: 'bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400' },
  { name: 'Processes', icon: '2', color: 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400' },
  { name: 'Advanced Signals', icon: '3', color: 'bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-400' },
  { name: 'IPC', icon: '4', color: 'bg-orange-100 dark:bg-orange-900/30 text-orange-700 dark:text-orange-400' },
  { name: 'Threads', icon: '5', color: 'bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400' },
  { name: 'Exam Prep', icon: '6', color: 'bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-400' },
];
---

<BaseLayout
  title="Operating Systems & C Programming"
  description="Systems programming in C — processes, signals, IPC, sockets, threads, and synchronization"
  currentPath="/os"
>
  {/* Course Hero */}
  <section class="relative overflow-hidden border-b border-surface-200 dark:border-surface-800">
    <div class="absolute inset-0 bg-gradient-to-br from-red-600/5 via-transparent to-orange-500/5 dark:from-red-600/10 dark:to-orange-500/10"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400 text-sm font-medium mb-4">
            Second Year Course
          </div>
          <h1 class="text-3xl sm:text-4xl font-bold text-surface-900 dark:text-white">
            {OS_COURSE.title}
          </h1>
          <p class="mt-3 text-surface-700 dark:text-surface-300 max-w-2xl leading-relaxed">
            {OS_COURSE.description}
          </p>
          <div class="mt-4 flex flex-wrap gap-4 text-sm text-surface-700 dark:text-surface-400">
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
              </svg>
              {lessons.length} lessons
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" />
              </svg>
              {lessons.reduce((sum, l) => sum + l.examples.length, 0)} code examples
            </span>
            <span class="flex items-center gap-1.5">
              <span class="font-mono text-xs px-1.5 py-0.5 rounded bg-surface-200 dark:bg-surface-700">C</span>
              Language
            </span>
            <span class="flex items-center gap-1.5">
              Instructor: {OS_COURSE.instructor}
            </span>
          </div>
        </div>
        <div class="lg:w-72 flex-shrink-0">
          <ProgressBar totalLessons={lessons.length} courseId="os" />
        </div>
      </div>
    </div>
  </section>

  {/* Concept Map / Phase Overview */}
  <section class="border-b border-surface-200 dark:border-surface-800 bg-surface-50 dark:bg-surface-900/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="flex gap-2 overflow-x-auto pb-2 scrollbar-hide">
        {phases.map(phase => {
          const count = lessons.filter(l => l.phase === phase.name).length;
          return (
            <a
              href={`#phase-${phase.name.toLowerCase().replace(/\s+/g, '-')}`}
              class={`flex-shrink-0 flex items-center gap-2 px-4 py-2.5 rounded-xl ${phase.color} font-medium text-sm hover:opacity-80 transition-opacity`}
            >
              <span class="font-bold">{phase.icon}</span>
              <span>{phase.name}</span>
              <span class="opacity-60">({count})</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  {/* Concept Dependency Graph */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <ConceptGraph />
  </section>

  {/* Lessons by Phase */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    {phases.map(phase => {
      const phaseLessons = lessons.filter(l => l.phase === phase.name);
      if (phaseLessons.length === 0) return null;
      return (
        <div id={`phase-${phase.name.toLowerCase().replace(/\s+/g, '-')}`} class="mb-16 scroll-mt-24">
          <div class="flex items-center gap-3 mb-6">
            <div class={`w-10 h-10 rounded-xl ${phase.color} flex items-center justify-center font-bold`}>
              {phase.icon}
            </div>
            <div>
              <h2 class="text-xl font-bold text-surface-900 dark:text-white">{phase.name}</h2>
              <p class="text-sm text-surface-700 dark:text-surface-400">{phaseLessons.length} lessons</p>
            </div>
          </div>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {phaseLessons.map(lesson => (
              <LessonCard
                number={lesson.number}
                title={lesson.title}
                description={lesson.description}
                tags={lesson.tags}
                difficulty={lesson.difficulty}
                exampleCount={lesson.examples.length}
                href={`/os/${lesson.slug}/`}
                phase={lesson.phase}
              />
            ))}
          </div>
        </div>
      );
    })}
  </section>

  {/* Resources */}
  <section class="border-t border-surface-200 dark:border-surface-800 bg-surface-50 dark:bg-surface-900/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-6">Resources</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <a href="https://www.academia.edu/1750088/_system_programming_-_" target="_blank" rel="noopener" class="card p-5 flex items-start gap-3 hover:-translate-y-0.5">
          <svg class="w-6 h-6 text-primary-600 dark:text-primary-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
          </svg>
          <div>
            <div class="font-semibold text-surface-900 dark:text-white">Course Textbook</div>
            <div class="text-sm text-surface-700 dark:text-surface-400">System Programming by Yoram Biberman</div>
          </div>
        </a>
        <a href="https://cs.hac.ac.il/staff/yoramb/heb_index.htm" target="_blank" rel="noopener" class="card p-5 flex items-start gap-3 hover:-translate-y-0.5">
          <svg class="w-6 h-6 text-primary-600 dark:text-primary-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
          </svg>
          <div>
            <div class="font-semibold text-surface-900 dark:text-white">Yoram Biberman's Materials</div>
            <div class="text-sm text-surface-700 dark:text-surface-400">Additional resources and books</div>
          </div>
        </a>
        <a href="https://github.com/YanivGabay/cs-lectures-by-yaniv-gabay" target="_blank" rel="noopener" class="card p-5 flex items-start gap-3 hover:-translate-y-0.5">
          <svg class="w-6 h-6 text-primary-600 dark:text-primary-400 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          <div>
            <div class="font-semibold text-surface-900 dark:text-white">Source Code</div>
            <div class="text-sm text-surface-700 dark:text-surface-400">All examples on GitHub</div>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
