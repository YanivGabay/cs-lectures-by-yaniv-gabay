{
  "name": "cs-lectures-terminal",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-15",

  "containers": [
    {
      // Student pool: pool-0, pool-1, pool-2 (6 sessions each)
      "class_name": "TerminalContainer",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 3
    },
    {
      // Reserved for the lecturer (reached only with a presenter pass from /presenter/login)
      "class_name": "PresenterContainer",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "TERMINAL", "class_name": "TerminalContainer" },
      { "name": "PRESENTER", "class_name": "PresenterContainer" },
      // Exact per-IP request counter (connections and presenter logins)
      { "name": "IP_COUNTER", "class_name": "IpCounter" }
    ]
  },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TerminalContainer"] },
    { "tag": "v2", "new_sqlite_classes": ["PresenterContainer"] },
    { "tag": "v3", "new_sqlite_classes": ["IpCounter"] }
  ]
}
